{
  "name": "@tjuae/web-cli",
  "version": "0.0.0",
  "private": true,
  "description": "TjuaeUI WebUI 命令行工具，不依赖 Electron 的独立 Web 运行时",
  "bin": {
    "tjuaeui-web": "./bin/tjuaeui-web.js"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tjuae/shared-scripts": "workspace:*",
    "@tjuae/web-host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  }
}
